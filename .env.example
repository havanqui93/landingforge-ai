# ---------------------------------------------------------------------------
# TrendPage AI environment variables
# Copy to .env (and .env.local for Next.js runtime) and fill in.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase, Neon, or local Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/trendpage?schema=public"

# AI provider. If OPENAI_API_KEY is unset, the generator falls back to a
# deterministic local template so the app still works end-to-end without a key.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Existing LandingForge daily-automation vars (unrelated to TrendPage AI):
# KV_REST_API_URL / KV_REST_API_TOKEN / CRON_SECRET
# ---------------------------------------------------------------------------
